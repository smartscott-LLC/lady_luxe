# Lady Luxe — 360° turntable generator environment
# Copy to .env and fill in. Never commit the real .env.

# Required — Sogni API key (https://dashboard.sogni.ai/api-key)
SOGNI_API_KEY=

# ---- Optional overrides (CLI flags take precedence) ----

# Supernet queue: "fast" (fair-use metered) or "relaxed"
SOGNI_TURNTABLE_NETWORK=fast

# Video model (MiniMax H3 first/last-frame family; must be an flf2v id)
#   minimax-h3-fl2va-fp8_flf2v            Standard, 20 steps
#   minimax-h3-fl2va-fp8_flf2v_balanced   Balanced, 8 steps
#   minimax-h3-fl2va-fp8_flf2v_turbo      LightX2V Turbo, 4 steps (default)
#   minimax-h3-fastvideo-int8_flf2v_turbo FastH3 Turbo, 4 steps
#   minimax-h3-fastvideo-int8_flf2v_turbo_2stage  FastH3 Turbo, 2x canvas
SOGNI_TURNTABLE_VIDEO_MODEL=minimax-h3-fl2va-fp8_flf2v_turbo

# Identity-preserving image edit model (Stage A/B keyframes)
#   krea2_identity_edit_v1_2  (default)
#   dark_beast_krea2_identity_edit_v1_2  (unrefused variant; auto-fallback target)
SOGNI_TURNTABLE_EDIT_MODEL=krea2_identity_edit_v1_2

# Fixed seed so the 0°/90°/180°/270° keyframes stay stylistically locked
SOGNI_TURNTABLE_SEED=42197

# ffmpeg binary (only if not on PATH)
FFMPEG_PATH=ffmpeg
